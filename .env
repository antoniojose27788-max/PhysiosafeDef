# MODO DE PRODUCCIÓN
NODE_ENV=production

#SERVIDOR Y URLs (IP del servidor)
APP_PORT=3000

FRONTEND_URL=http://10.0.14.10:3000
CORS_ORIGIN=http://10.0.14.10:3000

# BASE DE DATOS PHYSIOSAFE
DB_HOST=db
DB_PORT=5432
DB_PUBLIC_PORT=5432
DB_NAME=physiosafe
DB_USER=physiosafe_admin
DB_PASSWORD=change_this_super_secure_password
DB_DIALECT=postgres
DATABASE_URL=postgresql://physiosafe_admin:change_this_super_secure_password@localhost:5432/physiosafe

#BASE DE DATOS TYPEBOT

TYPEBOT_DB_NAME=typebotdb
TYPEBOT_DB_USER=typebotuser
TYPEBOT_DB_PASSWORD=change_this_typebot_db_password

JWT_SECRET=replace_with_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=http://10.0.14.10:3000

#TYPEBOT CONFIGURACIÓN
TYPEBOT_BUILDER_PORT=8081
TYPEBOT_VIEWER_PORT=8082
TYPEBOT_BUILDER_URL=http://10.0.14.10:8081
TYPEBOT_VIEWER_URL=http://10.0.14.10:8082

#SEGURIDAD
ENCRYPTION_SECRET=physiosafe_typebot_secret_2026xx
NEXTAUTH_SECRET=physiosafe_nextauth_secret_2026
TYPEBOT_WEBHOOK_SECRET=physiosafe_typebot_webhook_secret_change_me

#NGINX PROXY MANAGER
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

#CLOUDFLARE
TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
