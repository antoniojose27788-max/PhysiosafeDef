  "physiosafeWebhook": {
    "method": "POST",
    "path": "/api/typebot/intake",
    "requiredHeader": "X-PhysioSafe-Typebot-Secret",
    "bodyExample": {
      "name": "{{name}}",
      "email": "{{email}}",
      "phone": "{{phone}}",
      "contactPreference": "{{contactPreference}}",
      "privacyConsent": "{{privacyConsent}}",
      "firstVisit": "{{firstVisit}}",
      "reason": "{{reason}}",
      "area": "{{area}}",
      "symptomDuration": "{{symptomDuration}}",
      "pain": "{{pain}}",
      "urgency": "{{urgency}}",
      "redFlags": "{{redFlags}}",
      "previousTreatment": "{{previousTreatment}}",
      "insurance": "{{insurance}}",
      "physiotherapistEmail": "{{physiotherapistEmail}}",
      "availability": "{{availability}}",
      "preferredDate": "{{preferredDate}}",
      "preferredTime": "{{preferredTime}}",
      "source": "typebot"
    },
    "optionalFields": [
      "startsAt",
      "endsAt",
      "physiotherapistId",
      "physiotherapistEmail"
    ],
    "result": "Crea o actualiza paciente, guarda notas completas de admision y prepara una cita pendiente cuando encuentra hueco real."
  },
  "recommendedNextFeatures": [
    "Crear consentimiento inicial automaticamente cuando privacyConsent sea aceptado.",
    "Mostrar una bandeja de admisiones pendientes dentro del dashboard.",
    "Permitir que el equipo convierta una admision en cita programada con un clic.",
    "Enviar email o WhatsApp de confirmacion al paciente tras el webhook.",
    "Asignar fisioterapeuta por especialidad, zona afectada o carga de agenda."
  ],
