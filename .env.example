NODE_ENV=production
APP_PORT=3000

FRONTEND_URL=https://physiosafe.example.com
CORS_ORIGIN=https://physiosafe.example.com

DB_HOST=db
DB_PORT=5432
DB_PUBLIC_PORT=5432
DB_NAME=physiosafe
DB_USER=physiosafe_admin
DB_PASSWORD=replace_with_a_strong_database_password
DB_DIALECT=postgres
DB_SYNC_ALTER=false

JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

TYPEBOT_WEBHOOK_SECRET=replace_with_a_strong_typebot_webhook_secret

NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
